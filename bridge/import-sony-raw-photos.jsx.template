#target bridge
/*
 * Adobe Bridge startup script: adds Tools > Import Sony RAW Photos and Start/Stop Watching.
 * Generated from bridge/import-sony-raw-photos.jsx.template by
 * scripts/install-bridge-plugin.mjs -- edit the template, not this file.
 */
(function () {
	if (BridgeTalk.appName !== "bridge") return;

	var NODE = "__NODE__";
	var CLI = "__CLI__";
	var DEST = "__DEST__";
	var PATH = "__PATH__";
	var LOCK = "__LOCK__";

	function q(s) {
		return "'" + String(s).replace(/'/g, "'\\''") + "'";
	}

	function pad(n) {
		return n < 10 ? "0" + n : String(n);
	}

	function todayFolder() {
		var d = new Date();
		return DEST + "/" + d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
	}

	function runImport() {
		var log = new File(Folder.temp + "/import-sony-raw-photos.log");
		var cmd = "export PATH=" + q(PATH) + "; " + q(NODE) + " " + q(CLI) + " > " + q(log.fsName) + " 2>&1";
		var output = "";
		try {
			var code = app.system(cmd);
			if (log.open("r")) {
				output = log.read();
				log.close();
			}
			if (!output) output = "(no output; exit code " + code + ")";
		} catch (e) {
			Window.alert("Import failed to start:\n" + e);
			return;
		}
		var lines = String(output).replace(/\s+$/, "").split(/\r?\n/);
		// Keep the alert readable: last 15 lines (failures and the summary).
		Window.alert(lines.slice(-15).join("\n"));

		openDest();
	}

	// Show today's destination folder in Bridge (or the destination root if today's doesn't exist yet).
	function openDest() {
		var folder = new Folder(todayFolder());
		if (!folder.exists) folder = new Folder(DEST);
		if (!folder.exists) return;
		try {
			app.document.thumbnail = new Thumbnail(folder);
		} catch (e) {
			/* no browser window to navigate; ignore */
		}
	}

	// Run a shell command and return its stdout (app.system only gives the exit code).
	function sh(cmd) {
		var out = new File(Folder.temp + "/import-sony-raw-photos.sh.out");
		try {
			app.system("export PATH=" + q(PATH) + "; " + cmd + " > " + q(out.fsName) + " 2>&1");
			var text = "";
			if (out.open("r")) {
				text = out.read();
				out.close();
			}
			return String(text).replace(/\s+$/, "");
		} catch (e) {
			return "";
		}
	}

	// PID of a running watcher (from the import lock), or 0.
	function watcherPid() {
		var pid = parseInt(sh("cat " + q(LOCK)), 10);
		if (!pid) return 0;
		var cmd = sh("ps -p " + pid + " -o command=");
		return cmd.indexOf(CLI) !== -1 && cmd.indexOf("--watch") !== -1 ? pid : 0;
	}

	var watchLog = new File(Folder.temp + "/import-sony-raw-photos-watch.log");

	// Version of the installed importer, as reported by the CLI itself.
	function version() {
		return sh(q(NODE) + " " + q(CLI) + " --version") || "unknown";
	}

	function startWatch() {
		if (watcherPid()) {
			Window.alert("The watcher is already running (importer v" + version() + ").");
			return;
		}
		app.system(
			"export PATH=" + q(PATH) + "; nohup " + q(NODE) + " " + q(CLI) + " --watch > " + q(watchLog.fsName) + " 2>&1 < /dev/null &"
		);
		$.sleep(1500);
		if (watcherPid()) {
			openDest();
			Window.alert("Import Sony RAW Photos v" + version() + "\nWatching for new photos.\nLog: " + watchLog.fsName);
		} else {
			var text = "";
			if (watchLog.open("r")) {
				text = watchLog.read();
				watchLog.close();
			}
			Window.alert("The watcher did not start:\n" + String(text).replace(/\s+$/, "").split(/\r?\n/).slice(-10).join("\n"));
		}
	}

	function stopWatch() {
		var pid = watcherPid();
		if (!pid) {
			Window.alert("The watcher is not running.");
			return;
		}
		// SIGINT: the watcher finishes the import in progress, then exits.
		sh("kill -INT " + pid);
		Window.alert("Stopping the watcher (it finishes the import in progress first).");
	}

	var item = new MenuElement(
		"command",
		"Import Sony RAW Photos",
		"at the end of Tools",
		"importSonyRawPhotos"
	);
	item.onSelect = runImport;

	var startItem = new MenuElement(
		"command",
		"Start Watching Sony RAW Imports",
		"at the end of Tools",
		"startWatchSonyRawPhotos"
	);
	startItem.onSelect = startWatch;
	var stopItem = new MenuElement(
		"command",
		"Stop Watching Sony RAW Imports",
		"at the end of Tools",
		"stopWatchSonyRawPhotos"
	);
	stopItem.onSelect = stopWatch;
})();
